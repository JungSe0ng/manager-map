rules_version = '2';

// 매니저 관계도 접근 규칙
// - ADMIN_EMAILS: 팀원 목록을 관리할 수 있는 관리자 (본인 구글 이메일로 바꾸세요, 소문자)
// - 팀원 목록(meta/access.editors)에 있는 사람만 데이터를 읽고 쓸 수 있습니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function adminEmails() {
      return ['jungsam000@gmail.com'];
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn() && myEmail() in adminEmails();
    }

    function isEditor() {
      return signedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/meta/access) &&
         myEmail() in get(/databases/$(database)/documents/meta/access).data.editors)
      );
    }

    match /meta/access {
      allow read: if isEditor();
      allow write: if isAdmin();
    }

    match /meta/project {
      allow read, write: if isEditor();
    }

    match /managers/{managerId} {
      allow read, write: if isEditor();
    }

    match /links/{linkId} {
      allow read, write: if isEditor();
    }

    // 추가 페이지: boards/{페이지}/managers, boards/{페이지}/links
    match /boards/{boardId} {
      allow read, write: if isEditor();
      match /{sub}/{docId} {
        allow read, write: if isEditor() && sub in ['managers', 'links'];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
